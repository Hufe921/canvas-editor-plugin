  "license": "MIT",
  "version": "0.0.1",
  "description": "ofd export plugin for canvas-editor (based on @hufe921/jsofd)",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
