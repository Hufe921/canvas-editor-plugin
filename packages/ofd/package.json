    "@typescript-eslint/eslint-plugin": "4.33.0",
    "@typescript-eslint/parser": "4.33.0",
    "eslint": "7.32.0",
    "simple-git-hooks": "^2.8.1",
    "typescript": "^5.0.2",
    "vite": "^4.3.9"
  },
  "dependencies": {
    "@hufe921/jsofd": "^1.0.1",
    "jszip": "^3.7.1"
  },
