    "README.md",
    "LICENSE",
    "package.json"
  ],
  "typings": "./dist/src/ofd/index.d.ts",
  "main": "./dist/ofd.umd.cjs",
  "module": "./dist/ofd.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hufe921/canvas-editor-plugin.git"
  },
