{
  "name": "@hufe921/canvas-editor-plugin-spellcheck",
  "author": "Hufe",
  "license": "MIT",
  "version": "0.0.1",
  "description": "spellcheck plugin for canvas-editor",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "typings": "./dist/src/spellcheck/index.d.ts",
  "main": "./dist/spellcheck.umd.cjs",
  "module": "./dist/spellcheck.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hufe921/canvas-editor-plugin.git"
  },
  "keywords": [
    "canvas-editor",
    "spellcheck"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib",
    "release": "node scripts/release.js",
    "type:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@hufe921/canvas-editor": ">=1.0.2"
  },
  "devDependencies": {
    "@hufe921/canvas-editor": "1.0.2",
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "4.33.0",
    "@typescript-eslint/parser": "4.33.0",
    "eslint": "7.32.0",
    "sass": "^1.69.2",
    "simple-git-hooks": "^2.8.1",
    "typescript": "^5.0.2",
    "vite": "^4.3.9",
    "vite-plugin-css-injected-by-js": "^3.3.0"
  },
  "dependencies": {
    "@cspell/dict-en_us": "^4.4.37",
    "cspell-trie-lib": "^10.1.1"
  }
}
